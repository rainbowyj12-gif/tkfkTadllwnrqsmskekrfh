let dictionaryPage = 0;

function renderDictionary() {
  const container =
    document.getElementById("dictionary-cards");

  container.innerHTML = "";

  const collected = plants.filter(plant =>
    collectedPlants.has(plant.id)
  );

  const cardsPerPage = 3;
  const totalPages = Math.ceil(
    collected.length / cardsPerPage
  );

  if (totalPages === 0) {
    container.innerHTML = "<p>아직 발견한 식물이 없어요!</p>";
    return;
  }

  if (dictionaryPage >= totalPages) {
    dictionaryPage = totalPages - 1;
  }

  const start = dictionaryPage * cardsPerPage;
  const pagePlants = collected.slice(
    start,
    start + cardsPerPage
  );

  pagePlants.forEach(plant => {
    const card = document.createElement("div");
    card.className = "plant-card";

    card.innerHTML = `
      <img src="${plant.image}" alt="${plant.name}">
      <p>${plant.name}</p>
    `;

    card.addEventListener("click", () => {
      showLargeCard(plant);
    });

    container.appendChild(card);
  });

  const pageControls = document.createElement("div");
  pageControls.id = "dictionary-pagination";

  pageControls.innerHTML = `
    <button id="previous-page">이전</button>
    <span>${dictionaryPage + 1} / ${totalPages}</span>
    <button id="next-page">다음</button>
  `;

  container.appendChild(pageControls);

  document.getElementById("previous-page")
    .disabled = dictionaryPage === 0;

  document.getElementById("next-page")
    .disabled = dictionaryPage === totalPages - 1;

  document.getElementById("previous-page")
    .addEventListener("click", () => {
      dictionaryPage--;
      renderDictionary();
    });

  document.getElementById("next-page")
    .addEventListener("click", () => {
      dictionaryPage++;
      renderDictionary();
    });
}


function showLargeCard(plant) {

  document.getElementById("dictionary-popup").style.display = "none";

  document.getElementById("large-card-image").src = plant.image;

  document.getElementById("large-card-name").textContent =
    plant.name;

  document.getElementById("large-card").style.display = "flex";

}


document.getElementById("large-card")
  .addEventListener("click", () => {

    document.getElementById("large-card").style.display = "none";

    renderDictionary();

    document.getElementById("dictionary-popup").style.display = "block";

  });


function collectPlant(plantId) {

  const plant = plants.find(item => item.id === plantId);

  if (!plant) return;

  collectedPlants.add(plantId);

  updateCollectionCount();

  showLargeCard(plant);

}


document.getElementById("plant-upload")
  .addEventListener("change", async event => {

    const file = event.target.files[0];

    if (!file) return;

    if (!file.type.startsWith("image/")) {
      document.getElementById("recognition-result").textContent =
        "이미지 파일을 선택해주세요.";
      return;
    }

    const imageURL = URL.createObjectURL(file);

    const preview = document.getElementById("photo-preview");

    preview.src = imageURL;
    preview.style.display = "block";

    const result = document.getElementById("recognition-result");

    result.textContent = "AI가 식물을 분석하고 있습니다...";

    try {
      await loadPlantModel();

      await preview.decode();

      const predictions = await plantModel.predict(preview);

      predictions.sort((a, b) =>
        b.probability - a.probability
      );

      const best = predictions[0];

      const foundPlant = plants.find(
        plant => plant.name === best.className
      );


      if (!foundPlant || best.probability < 0.65) {
        result.textContent =
          "식물을 정확하게 인식하지 못했어요. 다시 촬영해주세요.";
        return;
      }

      result.textContent =
        foundPlant.name + " 발견!";

      collectPlant(foundPlant.id);

    } catch (error) {

      console.error(error);

      result.textContent =
        "AI 모델을 불러오지 못했어요. 모델 파일을 확인해주세요.";

    }

});


document.getElementById("exit-no")
  .addEventListener("click", () => {

    closeAllPopups();


  });


document.getElementById("exit-yes")
  .addEventListener("click", () => {

    clearInterval(typingTimer);

    isTyping = false;
    dialogueIndex = 0;
    afterResponse = "";

    collectedPlants.clear();

    updateCollectionCount();

    document.getElementById("plant-upload").value = "";

    document.getElementById("photo-preview").src = "";
    document.getElementById("photo-preview").style.display = "none";

    document.getElementById("recognition-result").textContent =
      "사진을 선택해주세요.";

    closeAllPopups();

    exploreScene.style.display = "none";
    introScene.style.display = "none";
    startScene.style.display = "flex";

  });


updateCollectionCount();
  </script>

