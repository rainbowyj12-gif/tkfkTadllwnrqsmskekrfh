
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>식물모아홍익랜듀얼레이드</title>

  <style>
    @font-face {
      font-family: 'Hippie';
      src: url('https://cdn.jsdelivr.net/gh/Project-Noonnu/2610081905@hippie/hippie/hippie_히피체.woff2') format('woff2');
      font-weight: 400;
      font-display: swap;
}  
  @font-face {
    font-family: 'IsYun';
    src: url('https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_2202-2@1.0/LeeSeoyun.woff') format('woff');
    font-weight: normal;
    font-display: swap;
} 

* {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: sans-serif;
    }

    button {
      border: none;
      padding: 0;
      background: transparent;
      cursor: pointer;
    }

    button img {
      display: block;
      max-width: 100%;
      height: auto;
    }

    #start,
    #intro,
    #explore {
      width: 100%;
      min-height: 100vh;
      background-color: #D5FAEA;
    }

    #start {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    h1 {
      font-family: "Hippie", sans-serif;
      color: #10564D;
      text-align: center;
      font-size: 75px;
    }

    #intro {
      display: none;
      position: relative;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      gap: 15px;
    }

    #character-image {
      max-width: 45vw;
      max-height: 45vh;
      object-fit: contain;
    }

    #dialogue-box {
      width: 90%;
      max-width: 900px;
      text-align: center;
      padding: 10px;
    }

    #dialogue-text {
      font-family: "Hippie", sans-serif;
      font-size: 50px;
      font-weight: bold;
      color: #10564D;
      line-height: 1.6;
      margin: 0;
      word-break: keep-all;
    }

    #click-hint {
      font-family: "IsYun", sans-serif;
      font-size: 16px;
      font-weight: 500;
      color: #78909C;
      margin: 5px 0;
      letter-spacing: 1px;
    }

    #choice-buttons {
      display: none;
      gap: 30px;
      align-items: center;
      justify-content: center;
      margin-top: 16px;
    }

    #choice-buttons img {
      width: 100px;
    }

    #back-button,
    #skip-button {
      position: absolute;
      top: 20px;
    }

    #back-button {
      left: 20px;
    }

    #skip-button {
      right: 20px;
    }

    #back-button img,
    #skip-button img {
      width: 55px;
    }

    #explore {
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      text-align: center;
    }

    @media (max-width: 600px) {
      h1 {
        font-size: 42px;
      }

      #dialogue-text {
        font-size: 23px;
      }

      #click-hint {
        font-size: 14px;
      }

      #character-image {
        max-width: 75vw;
      }
    }
  </style>
</head>

<body>

  <section id="start">
    <h1>식물모아홍익랜듀얼레이드</h1>

    <button id="start-button">
      <img src="시작하기.png" alt="시작하기">
    </button>
  </section>

  <section id="intro">

    <button id="back-button">
      <img src="뒤로가기.png" alt="뒤로가기">
    </button>

    <button id="skip-button">
      <img src="건너뛰기.png" alt="건너뛰기">
    </button>

    <img
      id="character-image"
      src="KakaoTalk_20261104_194403328_02.png"
      alt="오동이"
    >

    <div id="dialogue-box">
      <p id="dialogue-text"></p>
    </div>

    <p id="click-hint">화면을 클릭하세요</p>

    <div id="choice-buttons">

      <button id="yes-button">
        <img src="확인.png" alt="O">
      </button>

      <button id="no-button">
        <img src="취소.png" alt="X">
      </button>

    </div>

  </section>

  <!-- 탐험 화면 -->
  <section id="explore">
  </section>

  <script>
    const startScene = document.getElementById("start");
    const introScene = document.getElementById("intro");
    const exploreScene = document.getElementById("explore");

    const characterImage =
      document.getElementById("character-image");

    const dialogueText =
      document.getElementById("dialogue-text");

    const clickHint =
      document.getElementById("click-hint");

    const choiceButtons =
      document.getElementById("choice-buttons");

    const yesButton =
      document.getElementById("yes-button");

    const noButton =
      document.getElementById("no-button");

    const skipButton =
      document.getElementById("skip-button");

    const backButton =
      document.getElementById("back-button");


    const dialogues = [
      {
        character: "KakaoTalk_20261104_194403328_02.png",
        text: "안녕... 나는 오동이라고 해..."
      },

      {
        character: "KakaoTalk_20261104_194403328_02.png",
        text: "괴도식물단이 내가 모은 식물들을 훔쳐가 버렸어..."
      },

      {
        character: "KakaoTalk_20261104_194403328.png",
        text: "내가 열심히 모은 식물들을...!"
      }
    ];


    let dialogueIndex = 0;
    let typingTimer = null;
    let isTyping = false;
    let currentFullText = "";
    let afterResponse = "";


    document.getElementById("start-button")
      .addEventListener("click", () => {

        startScene.style.display = "none";
        exploreScene.style.display = "none";
        introScene.style.display = "flex";

        dialogueIndex = 0;
        afterResponse = "";

        showDialogue(dialogues[dialogueIndex]);
      });


    function showDialogue(dialogue) {

      clearInterval(typingTimer);

      choiceButtons.style.display = "none";
      clickHint.style.display = "block";

      currentFullText = dialogue.text;

      characterImage.src = dialogue.character;
      dialogueText.textContent = "";

      let charIndex = 0;

      isTyping = true;

      typingTimer = setInterval(() => {

        dialogueText.textContent +=
          currentFullText.charAt(charIndex);

        charIndex++;

        if (charIndex >= currentFullText.length) {

          clearInterval(typingTimer);
          isTyping = false;

        }

      }, 55);
    }


    function showQuestion() {

      clearInterval(typingTimer);
      isTyping = false;

      characterImage.src =
        "KakaoTalk_20261104_194403328_02.png";

      currentFullText =
        "그래서 말이야... 괜찮다면, 내 식물들을 찾아줄래...?";

      dialogueText.textContent = currentFullText;

      clickHint.style.display = "none";
      choiceButtons.style.display = "flex";
    }


    function advanceDialogue() {

      if (isTyping) {

        clearInterval(typingTimer);

        dialogueText.textContent = currentFullText;

        isTyping = false;

        return;
      }

      if (afterResponse === "repeat-question") {

        afterResponse = "";

        showQuestion();

        return;
      }

      if (afterResponse === "go-explore") {

        afterResponse = "";

        goToExplore();

        return;
      }

      dialogueIndex++;

      if (dialogueIndex < dialogues.length) {

        showDialogue(dialogues[dialogueIndex]);

      } else {

        showQuestion();

      }
    }



    introScene.addEventListener("click", (event) => {

      if (event.target.closest("button")) return;

      if (choiceButtons.style.display === "flex") return;

      advanceDialogue();

    });



    yesButton.addEventListener("click", () => {

      afterResponse = "go-explore";

      showDialogue({

        character:
          "KakaoTalk_20261104_194403328_01.png",

        text: "그래? 정말 고마워...!"

      });

    });


    noButton.addEventListener("click", () => {

      afterResponse = "repeat-question";

      showDialogue({

        character:
          "KakaoTalk_20261104_194403328_02.png",

        text: "진짜...? 한 번만 더 생각해주면 안 될까...?"

      });

    });


    backButton.addEventListener("click", () => {

      clearInterval(typingTimer);

      isTyping = false;
      afterResponse = "";
      dialogueIndex = 0;

      introScene.style.display = "none";
      exploreScene.style.display = "none";
      startScene.style.display = "flex";

    });


    skipButton.addEventListener("click", goToExplore);

    function goToExplore() {

      clearInterval(typingTimer);

      isTyping = false;

      startScene.style.display = "none";
      introScene.style.display = "none";
      exploreScene.style.display = "flex";

    }

  </script>

</body>
</html>
