    });


    backButton.addEventListener("click", () => {

      clearInterval(typingTimer);

      isTyping = false;
      afterResponse = "";
      dialogueIndex = 0;

      introScene.style.display = "none";
      exploreScene.style.display = "none";
      startScene.style.display = "flex";

    });


    skipButton.addEventListener("click", goToExplore);

